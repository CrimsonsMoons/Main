local function rememberHitboxProperties(part)
	if OriginalHitboxProperties[part] then
		return
	end

	OriginalHitboxProperties[part] = {
		Size = part.Size,
		CanCollide = part.CanCollide,
		CanTouch = part.CanTouch,
		CanQuery = part.CanQuery,
		Massless = part.Massless,
		Transparency = part.Transparency,
	}
end

local function removeHitboxVisual(part)
	local visual = HitboxVisuals[part]

	if visual then
		pcall(function()
			visual:Destroy()
		end)
	end

	HitboxVisuals[part] = nil
end

local function removeAllHitboxVisuals()
	local parts = {}

	for part in pairs(HitboxVisuals) do
		table.insert(parts, part)
	end

	for _, part in ipairs(parts) do
		removeHitboxVisual(part)
	end
end

local function updateHitboxVisual(part)
	if not HitboxState.Enabled
		or not HitboxState.VisualEnabled
		or not part
		or not part.Parent then

		removeHitboxVisual(part)
		return
	end

	local visual = HitboxVisuals[part]

	if not visual or not visual.Parent then
		visual = Instance.new("SelectionBox")
		visual.Name = "CrimsonHitboxVisual"
		visual.Adornee = part
		visual.Color3 = Color3.fromRGB(255, 65, 65)
		visual.SurfaceColor3 = Color3.fromRGB(255, 65, 65)
		visual.SurfaceTransparency = 1
		visual.LineThickness = 0.04
		visual.Parent = part

		HitboxVisuals[part] = visual
	else
		visual.Adornee = part
	end
end

local function restoreHitboxPart(part)
	local original = OriginalHitboxProperties[part]

	removeHitboxVisual(part)

	if not original then
		return
	end

	if part and part.Parent then
		pcall(function()
			part.Size = original.Size
			part.CanCollide = original.CanCollide
			part.CanTouch = original.CanTouch
			part.CanQuery = original.CanQuery
			part.Massless = original.Massless
			part.Transparency = original.Transparency
		end)
	end

	OriginalHitboxProperties[part] = nil
end

local function restoreAllHitboxes()
	local parts = {}

	for part in pairs(OriginalHitboxProperties) do
		table.insert(parts, part)
	end

	for _, part in ipairs(parts) do
		restoreHitboxPart(part)
	end
end

local function getHitboxParts(item)
	local results = {}
	local added = {}

	local function add(part)
		if not part
			or not part:IsA("BasePart")
			or added[part] then

			return
		end

		added[part] = true
		table.insert(results, part)
	end

	if item:IsA("BasePart") then
		add(item)
	end

	for _, descendant in ipairs(item:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local lowerName = string.lower(descendant.Name)

			if string.find(lowerName, "hitbox", 1, true)
				or lowerName == "hit box" then

				add(descendant)
			end
		end
	end

	-- Use Handle only when the item has no dedicated hitbox.
	if #results == 0 then
		add(item:FindFirstChild("Handle", true))
	end

	return results
end

local function resizeHitboxPart(part)
	if not HitboxState.Enabled
		or not part
		or not part.Parent then

		return
	end

	rememberHitboxProperties(part)

	local size = math.clamp(
		tonumber(HitboxState.Size) or 40,
		5,
		40
	)

	part.Size = Vector3.new(size, size, size)
	part.CanCollide = false
	part.CanTouch = true
	part.CanQuery = true
	part.Massless = true

	updateHitboxVisual(part)
end

local function applyHitboxToItem(item)
	if not HitboxState.Enabled
		or not isPossibleHeldItem(item) then

		return false
	end

	local hitboxes = getHitboxParts(item)

	if #hitboxes == 0 then
		return false
	end

	for _, part in ipairs(hitboxes) do
		resizeHitboxPart(part)
	end

	return true
end

local function applyHitboxToEquippedItem()
	if not HitboxState.Enabled then
		return
	end

	local item = getEquippedItem()

	if item then
		applyHitboxToItem(item)
	end
end

local function bindEquipmentContainer(container)
	if not container
		or not container.Parent
		or BoundContainers[container] then

		return
	end

	BoundContainers[container] = true

	-- Apply to an item already equipped.
	task.defer(applyHitboxToEquippedItem)

	trackConnection(container.ChildAdded:Connect(function(child)
		task.spawn(function()
			-- Some tools add Handle/Hitbox after being parented.
			for _ = 1, 15 do
				if not child.Parent then
					break
				end

				if HitboxState.Enabled and isPossibleHeldItem(child) then
					if applyHitboxToItem(child) then
						break
					end
				end

				task.wait(0.1)
			end
		end)
	end))

	trackConnection(container.AncestryChanged:Connect(function(_, parent)
		if not parent then
			BoundContainers[container] = nil
		end
	end))
end

local function bindCurrentEquipmentContainers()
	for _, container in ipairs(getEquipmentContainers()) do
		bindEquipmentContainer(container)
	end
end

local function setHitboxEnabled(state)
	HitboxState.Enabled = state == true

	if HitboxState.Enabled then
		bindCurrentEquipmentContainers()
		applyHitboxToEquippedItem()
	else
		restoreAllHitboxes()
		removeAllHitboxVisuals()
	end

	print(
		"Tool Hitbox:",
		HitboxState.Enabled and "ON" or "OFF"
	)
end

local function setHitboxVisualEnabled(state)
	HitboxState.VisualEnabled = state == true

	if HitboxState.VisualEnabled and HitboxState.Enabled then
		applyHitboxToEquippedItem()
	else
		removeAllHitboxVisuals()
	end

	print(
		"Hitbox Visual:",
		HitboxState.VisualEnabled and "ON" or "OFF"
	)
end

