--==================================================
-- CRIMSON HUB - MAIN + MOVEMENT
-- Ventura / MenuXD
--
-- Main tab:
--   • Auto Use Equipped Item
--   • J keybind
--   • UseItem remote every 0.05 seconds
--   • Equipped Tool Hitbox (off by default)
--   • Hitbox visual outline
--   • Hitbox size slider (5–40)
--   • Auto Farm enemy-name multi-selection
--   • Persistent Mimic target selection
--   • Separate enemy and Mimic farm toggles
--   • Enemy Data tab with last-seen pivots
--   • Cached-position travel for streamed-out enemies
--   • Resources tab sourced from Cube Cave CurrentResources
--   • Search fields on every dropdown
--   • 220 preloaded last-seen pivots (live search still enabled)
--   • Auto Block toggle (0.07-second interval)
--   • Auto Use multiplier dropdown (1x–5x)
--
-- Movement tab:
--   • Fly toggle
--   • X keybind
--   • Fly speed slider
--   • Vertical speed slider
--==================================================

--==================================================
-- SERVICES
--==================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- LOAD VENTURA / MENUXD
--==================================================
local Library = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/DestroyTheO/MenuXD/refs/heads/main/Main"
))()

local Window = Library:CreateWindow({
	name = "Crimson Hub",
	subtitle = "Universal",
	theme = "Carbon",
	toggleKey = Enum.KeyCode.RightShift,
})

local MainTab = Window:CreateTab({
	name = "Main",
})

local MovementTab = Window:CreateTab({
	name = "Movement",
})

local EnemyDataTab = Window:CreateTab({
	name = "Enemy Data",
	icon = Library.Icons.location,
})

local ResourcesTab = Window:CreateTab({
	name = "Resources",
	icon = Library.Icons.diamond,
})

--==================================================
-- USE ITEM REMOTE
--==================================================
local UseItemRemote = ReplicatedStorage
	:WaitForChild("ClientRemotes")
	:WaitForChild("Character")
	:WaitForChild("UseItem")

local BlockRemote = ReplicatedStorage
	:WaitForChild("ClientRemotes")
	:WaitForChild("Character")
	:WaitForChild("Block")

