	CurrentTarget = nil,
	CurrentCachedRecord = nil,
}

PersistentFarmState.EnemyNames = AutoFarmState.EnemyNames
PersistentFarmState.MimicNames = AutoFarmState.MimicNames
PersistentFarmState.PositionRecords =
	type(PersistentFarmState.PositionRecords) == "table"
	and PersistentFarmState.PositionRecords
	or {}
PersistentFarmState.NextPositionRecordId =
	math.max(
		0,
		math.floor(
			tonumber(PersistentFarmState.NextPositionRecordId) or 0
		)
	)


