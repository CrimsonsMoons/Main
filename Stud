local IgnoredCharacterNames = {
	["Humanoid"] = true,
	["HumanoidRootPart"] = true,
	["Head"] = true,
	["UpperTorso"] = true,
	["LowerTorso"] = true,
	["Torso"] = true,

	["RightHand"] = true,
	["LeftHand"] = true,
	["RightLowerArm"] = true,
	["LeftLowerArm"] = true,
	["RightUpperArm"] = true,
	["LeftUpperArm"] = true,
	["Right Arm"] = true,
	["Left Arm"] = true,

	["RightFoot"] = true,
	["LeftFoot"] = true,
	["RightLowerLeg"] = true,
	["LeftLowerLeg"] = true,
	["RightUpperLeg"] = true,
	["LeftUpperLeg"] = true,
	["Right Leg"] = true,
	["Left Leg"] = true,

	["Animate"] = true,
	["Health"] = true,
	["Body Colors"] = true,
}

local KnownHeldKeywords = {
	"sword",
	"pickaxe",
	"hatchet",
	"shovel",
	"axe",
	"hammer",
	"weapon",
	"tool",
}

local function isIgnoredCharacterObject(item)
	if not item then
		return true
	end

	if IgnoredCharacterNames[item.Name] then
		return true
	end

	return item:IsA("Humanoid")
		or item:IsA("Animator")
		or item:IsA("Accessory")
		or item:IsA("Shirt")
		or item:IsA("Pants")
		or item:IsA("BodyColors")
		or item:IsA("CharacterMesh")
		or item:IsA("Script")
		or item:IsA("LocalScript")
		or item:IsA("ModuleScript")
end

local function containsKnownHeldKeyword(name)
	local lowerName = string.lower(name)

	for _, keyword in ipairs(KnownHeldKeywords) do
		if string.find(lowerName, keyword, 1, true) then
			return true
		end
	end

	return false
end

local function hasHeldPart(item)
	if item:IsA("BasePart") then
		return true
	end

	return item:FindFirstChild("Handle", true)
		or item:FindFirstChild("Hitbox", true)
		or item:FindFirstChild("HitBox", true)
		or item:FindFirstChild("Grip", true)
end

local function isPossibleHeldItem(item)
	if not item or not item.Parent or isIgnoredCharacterObject(item) then
		return false
	end

	if item:IsA("Tool") then
		return true
	end

	if containsKnownHeldKeyword(item.Name) then
		return true
	end

	if item:IsA("Model") or item:IsA("Folder") then
		return hasHeldPart(item) ~= nil
	end

	return false
end

local function getEquipmentContainers()
	local containers = {}
	local seen = {}

	local function add(container)
		if container and container.Parent and not seen[container] then
			seen[container] = true
			table.insert(containers, container)
		end
	end

	add(getCustomCharacter())
	add(LocalPlayer.Character)

	return containers
end

local function getEquippedItem()
	local containers = getEquipmentContainers()

	-- First priority: standard equipped Tool objects.
	for _, container in ipairs(containers) do
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool") then
				return child
			end
		end
	end

	-- Second priority: known held-item names.
	for _, container in ipairs(containers) do
		for _, child in ipairs(container:GetChildren()) do
			if not isIgnoredCharacterObject(child)
				and containsKnownHeldKeyword(child.Name) then

				return child
			end
		end
	end

	-- Final fallback: models/folders containing Handle, Hitbox, or Grip.
	for _, container in ipairs(containers) do
		for _, child in ipairs(container:GetChildren()) do
			if isPossibleHeldItem(child) then
				return child
			end
		end
	end

	return nil
end

--==================================================
-- MAIN: AUTO BLOCK
--==================================================
local AutoBlockToggle

local function fireBlock()
	if not BlockRemote or not BlockRemote.Parent then
		return false
	end

	BlockRemote:FireServer(true)
	return true
end

local function setAutoBlockEnabled(state, synchronizeToggle)
	AutoBlockState.Enabled = state == true
	AutoBlockState.Generation += 1

	if synchronizeToggle and AutoBlockToggle then
		AutoBlockToggle:Set(
			AutoBlockState.Enabled,
			true
		)
	end

	if not AutoBlockState.Enabled then
		print("Auto Block: OFF")
		return
	end

	print("Auto Block: ON")

	local generation = AutoBlockState.Generation

	task.spawn(function()
		while AutoBlockState.Enabled
			and AutoBlockState.Generation == generation do

			fireBlock()
			task.wait(AutoBlockState.Interval)
		end
	end)
end

