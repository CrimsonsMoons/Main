-- MAIN: USEITEM REMOTE
--==================================================
local function fireEquippedItem()
	local item = getEquippedItem()

	if not item or not item.Parent then
		return false
	end

	local lowerName = string.lower(item.Name)

	-- Preserve the sword argument format originally supplied.
	if string.find(lowerName, "sword", 1, true) then
		UseItemRemote:FireServer(
			item,
			false,
			nil,
			nil,
			0.6
		)
	else
		UseItemRemote:FireServer(
			item,
			false
		)
	end

	return true
end

local AutoUseToggle

local function setAutoUseEnabled(state, synchronizeToggle)
	AutoUseState.Enabled = state == true
	AutoUseState.Generation += 1

	if synchronizeToggle and AutoUseToggle then
		AutoUseToggle:Set(AutoUseState.Enabled, true)
	end

	if not AutoUseState.Enabled then
		print("Auto Use: OFF")
		return
	end

	print("Auto Use: ON")

	local thisGeneration = AutoUseState.Generation

	task.spawn(function()
		while AutoUseState.Enabled
			and AutoUseState.Generation == thisGeneration do

			local multiplier = math.clamp(
				tonumber(AutoUseState.Multiplier) or 1,
				1,
				5
			)

			for _ = 1, multiplier do
				if not AutoUseState.Enabled
					or AutoUseState.Generation ~= thisGeneration then

					break
				end

				fireEquippedItem()
			end

			task.wait(AUTO_USE_INTERVAL)
		end
	end)
end

--==================================================
-- MAIN: TOOL HITBOX
--==================================================
local function rememberHitboxProperties(part)
	if OriginalHitboxProperties[part] then
		return
	end

	OriginalHitboxProperties[part] = {
		Size = part.Size,
		CanCollide = part.CanCollide,
		CanTouch = part.CanTouch,
		CanQuery = part.CanQuery,
		Massless = part.Massless,
		Transparency = part.Transparency,
	}
end

local function removeHitboxVisual(part)
	local visual = HitboxVisuals[part]

	if visual then
		pcall(function()
			visual:Destroy()
		end)
	end

	HitboxVisuals[part] = nil
end

local function removeAllHitboxVisuals()
	local parts = {}

	for part in pairs(HitboxVisuals) do
		table.insert(parts, part)
	end

	for _, part in ipairs(parts) do
		removeHitboxVisual(part)
	end
end

local function updateHitboxVisual(part)
	if not HitboxState.Enabled
		or not HitboxState.VisualEnabled
		or not part
		or not part.Parent then

		removeHitboxVisual(part)
		return
	end

	local visual = HitboxVisuals[part]

	if not visual or not visual.Parent then
		visual = Instance.new("SelectionBox")
		visual.Name = "CrimsonHitboxVisual"
		visual.Adornee = part
		visual.Color3 = Color3.fromRGB(255, 65, 65)
		visual.SurfaceColor3 = Color3.fromRGB(255, 65, 65)
		visual.SurfaceTransparency = 1
		visual.LineThickness = 0.04
		visual.Parent = part

		HitboxVisuals[part] = visual
	else
		visual.Adornee = part
	end
end

local function restoreHitboxPart(part)
	local original = OriginalHitboxProperties[part]

	removeHitboxVisual(part)

	if not original then
		return
	end

	if part and part.Parent then
		pcall(function()
			part.Size = original.Size
			part.CanCollide = original.CanCollide
			part.CanTouch = original.CanTouch
			part.CanQuery = original.CanQuery
			part.Massless = original.Massless
			part.Transparency = original.Transparency
		end)
	end

	OriginalHitboxProperties[part] = nil
end

local function restoreAllHitboxes()
	local parts = {}

	for part in pairs(OriginalHitboxProperties) do
		table.insert(parts, part)
	end

	for _, part in ipairs(parts) do
		restoreHitboxPart(part)
	end
end

local function getHitboxParts(item)
	local results = {}
	local added = {}

	local function add(part)
		if not part
			or not part:IsA("BasePart")
			or added[part] then

			return
		end

		added[part] = true
		table.insert(results, part)
	end

	if item:IsA("BasePart") then
		add(item)
	end

	for _, descendant in ipairs(item:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local lowerName = string.lower(descendant.Name)

			if string.find(lowerName, "hitbox", 1, true)
				or lowerName == "hit box" then

				add(descendant)
			end
		end
	end

	-- Use Handle only when the item has no dedicated hitbox.
	if #results == 0 then
		add(item:FindFirstChild("Handle", true))
	end

	return results
end

local function resizeHitboxPart(part)
	if not HitboxState.Enabled
		or not part
		or not part.Parent then

		return
	end

	rememberHitboxProperties(part)

	local size = math.clamp(
		tonumber(HitboxState.Size) or 40,
		5,
		40
	)

	part.Size = Vector3.new(size, size, size)
	part.CanCollide = false
	part.CanTouch = true
	part.CanQuery = true
	part.Massless = true

	updateHitboxVisual(part)
end

local function applyHitboxToItem(item)
	if not HitboxState.Enabled
		or not isPossibleHeldItem(item) then

		return false
	end

	local hitboxes = getHitboxParts(item)

	if #hitboxes == 0 then
		return false
	end

	for _, part in ipairs(hitboxes) do
		resizeHitboxPart(part)
	end

	return true
end

local function applyHitboxToEquippedItem()
	if not HitboxState.Enabled then
		return
	end

	local item = getEquippedItem()

	if item then
		applyHitboxToItem(item)
	end
end

local function bindEquipmentContainer(container)
	if not container
		or not container.Parent
		or BoundContainers[container] then

		return
	end

	BoundContainers[container] = true

	-- Apply to an item already equipped.
	task.defer(applyHitboxToEquippedItem)

	trackConnection(container.ChildAdded:Connect(function(child)
		task.spawn(function()
			-- Some tools add Handle/Hitbox after being parented.
			for _ = 1, 15 do
				if not child.Parent then
					break
				end

				if HitboxState.Enabled and isPossibleHeldItem(child) then
					if applyHitboxToItem(child) then
						break
					end
				end

				task.wait(0.1)
			end
		end)
	end))

	trackConnection(container.AncestryChanged:Connect(function(_, parent)
		if not parent then
			BoundContainers[container] = nil
		end
	end))
end

local function bindCurrentEquipmentContainers()
	for _, container in ipairs(getEquipmentContainers()) do
		bindEquipmentContainer(container)
	end
end

local function setHitboxEnabled(state)
	HitboxState.Enabled = state == true

	if HitboxState.Enabled then
		bindCurrentEquipmentContainers()
		applyHitboxToEquippedItem()
	else
		restoreAllHitboxes()
		removeAllHitboxVisuals()
	end

	print(
		"Tool Hitbox:",
		HitboxState.Enabled and "ON" or "OFF"
	)
end

local function setHitboxVisualEnabled(state)
	HitboxState.VisualEnabled = state == true

	if HitboxState.VisualEnabled and HitboxState.Enabled then
		applyHitboxToEquippedItem()
	else
		removeAllHitboxVisuals()
	end

	print(
		"Hitbox Visual:",
		HitboxState.VisualEnabled and "ON" or "OFF"
	)
end

--==================================================
-- MAIN: AUTO FARM
--==================================================
local EnemyDropdown
local MimicDropdown
local EnemyFarmToggle
local MimicFarmToggle

local function arrayToSet(values)
	local result = {}

	if type(values) == "table" then
		for _, value in ipairs(values) do
			result[value] = true
		end
	end

	return result
end

local function isBlacklistedEnemyName(name)
	return type(name) == "string"
		and string.find(
			string.lower(name),
			"target dummy",
			1,
			true
		) ~= nil
end

local function isMimicName(name)
	return type(name) == "string"
		and string.find(
			string.lower(name),
			"mimic",
			1,
			true
		) ~= nil
end

local function sortedEnemyNames()
	local names = {}

	for name, exists in pairs(AutoFarmState.EnemyNames) do
		if exists
			and not isBlacklistedEnemyName(name)
			and not isMimicName(name) then

			table.insert(names, name)
		end
	end

	table.sort(names, function(a, b)
		return string.lower(a) < string.lower(b)
	end)

	return names
end

local function sortedMimicNames()
	local names = {}

	for name, exists in pairs(AutoFarmState.MimicNames) do
		if exists and not isBlacklistedEnemyName(name) then
			table.insert(names, name)
		end
	end

	table.sort(names, function(a, b)
		return string.lower(a) < string.lower(b)
	end)

	return names
end

local function getAreaEnemiesFolder(areaName)
	local areas = Workspace:FindFirstChild("Areas")
	local area = areas and areas:FindFirstChild(areaName)

	return area and area:FindFirstChild("Enemies")
end

local function getEnemyHumanoid(enemy)
	if not enemy or not enemy.Parent then
		return nil
	end

	local named = enemy:FindFirstChild("EnemyHumanoid", true)

	if named and named:IsA("Humanoid") then
		return named
	end

	return enemy:FindFirstChildWhichIsA("Humanoid", true)
end

local function getEnemyRoot(enemy)
	if not enemy or not enemy.Parent then
		return nil
	end

	if enemy:IsA("BasePart") then
		return enemy
	end

	local primaryPart =
		enemy:IsA("Model")
		and enemy.PrimaryPart
		or nil

	return enemy:FindFirstChild("HumanoidRootPart", true)
		or primaryPart
		or enemy:FindFirstChildWhichIsA("BasePart", true)
end

local function isAliveEnemy(enemy)
	local humanoid = getEnemyHumanoid(enemy)
	local root = getEnemyRoot(enemy)

	return humanoid
		and root
		and humanoid.Health > 0
		and humanoid.MaxHealth > 0
end

local function rememberEnemyName(name)
	if type(name) ~= "string"
		or isBlacklistedEnemyName(name) then

		return false
	end

	if isMimicName(name) then
		return false
	end

	if AutoFarmState.EnemyNames[name] then
		return false
	end

	AutoFarmState.EnemyNames[name] = true
	PersistentFarmState.EnemyNames = AutoFarmState.EnemyNames

	return true
end

local function rememberMimicName(name)
	if type(name) ~= "string"
		or isBlacklistedEnemyName(name)
		or not isMimicName(name) then

		return false
	end

	if AutoFarmState.MimicNames[name] then
		return false
	end

	AutoFarmState.MimicNames[name] = true
	PersistentFarmState.MimicNames = AutoFarmState.MimicNames

	return true
end

local function scanEnemyNamesAndMimics()
	local enemyChanged = false
	local mimicChanged = false

	for _, areaName in ipairs(AREA_NAMES) do
		local folder = getAreaEnemiesFolder(areaName)

		if folder then
			for _, enemy in ipairs(folder:GetChildren()) do
				if not isBlacklistedEnemyName(enemy.Name) then
					if isMimicName(enemy.Name) then
						if rememberMimicName(enemy.Name) then
							mimicChanged = true
						end
					else
						if rememberEnemyName(enemy.Name) then
							enemyChanged = true
						end
					end
				end
			end
		end
	end

	-- These caches only grow. Names are never removed when enemies
	-- despawn, so selections remain available for future respawns.
	if enemyChanged and EnemyDropdown then
		EnemyDropdown:SetItems(sortedEnemyNames())
		EnemyDropdown:Set(
			AutoFarmState.SelectedEnemies,
			true
		)
	end

	if mimicChanged and MimicDropdown then
		MimicDropdown:SetItems(sortedMimicNames())
		MimicDropdown:Set(
			AutoFarmState.SelectedMimics,
			true
		)
	end
end

local function targetMatchesNameFilters(enemy, enemySet, mimicSet)
	if isBlacklistedEnemyName(enemy.Name) then
		return false
	end

	if isMimicName(enemy.Name) then
		return next(mimicSet) == nil
			or mimicSet[enemy.Name] == true
	end

	return next(enemySet) == nil
		or enemySet[enemy.Name] == true
end

local function collectFarmTargets()
	local targets = {}
	local selectedEnemySet =
		arrayToSet(AutoFarmState.SelectedEnemies)
	local selectedMimicSet =
		arrayToSet(AutoFarmState.SelectedMimics)

	for _, areaName in ipairs(AREA_NAMES) do
		local folder = getAreaEnemiesFolder(areaName)

		if folder then
			for _, enemy in ipairs(
				folder:GetChildren()
			) do
				if not isBlacklistedEnemyName(enemy.Name) then
					local mimic = isMimicName(enemy.Name)

					if mimic then
						rememberMimicName(enemy.Name)
					else
						rememberEnemyName(enemy.Name)
					end

					local categoryEnabled =
						(mimic and AutoFarmState.MimicEnabled)
						or (
							not mimic
							and AutoFarmState.EnemyEnabled
						)

					if categoryEnabled
						and isAliveEnemy(enemy)
						and targetMatchesNameFilters(
							enemy,
							selectedEnemySet,
							selectedMimicSet
						) then

						table.insert(targets, enemy)
					end
				end
			end
		end
	end

	return targets
end

local function isAnyFarmEnabled()
	return AutoFarmState.EnemyEnabled
		or AutoFarmState.MimicEnabled
end

local function cancelFarmTween()
	local tween = AutoFarmState.CurrentTween

	if tween then
		pcall(function()
			tween:Cancel()
		end)
	end

	AutoFarmState.CurrentTween = nil
end

local function getFarmCharacterRoot()
	local character = getMovementCharacter()

	return character
		and character:FindFirstChild("HumanoidRootPart")
end

local function tweenBehindEnemy(enemy)
	local playerRoot = getFarmCharacterRoot()
	local enemyRoot = getEnemyRoot(enemy)
	local enemyHumanoid = getEnemyHumanoid(enemy)

	if not playerRoot
		or not enemyRoot
		or not enemyHumanoid
		or enemyHumanoid.Health <= 0 then

		return false
	end

	local destination =
		enemyRoot.CFrame
		* CFrame.new(
			0,
			0,
			AutoFarmState.BehindDistance
		)

	local distance =
		(playerRoot.Position - destination.Position).Magnitude

	local duration = math.clamp(
		distance / AutoFarmState.TweenSpeed,
		0.03,
		0.25
	)

	cancelFarmTween()

	local tween = TweenService:Create(
		playerRoot,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = destination,
		}
	)

	AutoFarmState.CurrentTween = tween
	tween:Play()

	task.wait(math.min(duration, 0.10))

	return enemyHumanoid.Health > 0
		and enemy.Parent ~= nil
end

local function runAutoFarm(generation)
	while isAnyFarmEnabled()
		and AutoFarmState.Generation == generation do

		scanEnemyNamesAndMimics()

		local targets = collectFarmTargets()
		local target = targets[1]

		if not target then
			AutoFarmState.CurrentTarget = nil
			cancelFarmTween()
			task.wait(0.20)
			continue
		end

		AutoFarmState.CurrentTarget = target

		while isAnyFarmEnabled()
			and AutoFarmState.Generation == generation
			and target.Parent
			and isAliveEnemy(target) do

			local targetIsMimic =
				isMimicName(target.Name)

			local categoryStillEnabled =
				(
					targetIsMimic
					and AutoFarmState.MimicEnabled
				)
				or (
					not targetIsMimic
					and AutoFarmState.EnemyEnabled
				)

			if not categoryStillEnabled
				or not tweenBehindEnemy(target) then

				break
			end
		end

		cancelFarmTween()
		AutoFarmState.CurrentTarget = nil
		task.wait()
	end

	cancelFarmTween()
	AutoFarmState.CurrentTarget = nil
end

local function restartAutoFarmLoop()
	AutoFarmState.Generation += 1
	cancelFarmTween()
	AutoFarmState.CurrentTarget = nil

	if not isAnyFarmEnabled() then
		return
	end

	local generation = AutoFarmState.Generation

	task.spawn(function()
		runAutoFarm(generation)
	end)
end

local function setEnemyFarmEnabled(state, synchronizeToggle)
	AutoFarmState.EnemyEnabled = state == true

	if synchronizeToggle and EnemyFarmToggle then
		EnemyFarmToggle:Set(
			AutoFarmState.EnemyEnabled,
