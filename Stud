Library:RegisterGlobalCleanup(function()
	AutoUseState.Enabled = false
	AutoUseState.Generation += 1

	AutoBlockState.Enabled = false
	AutoBlockState.Generation += 1

	AutoFarmState.EnemyEnabled = false
	AutoFarmState.MimicEnabled = false
	AutoFarmState.Generation += 1
	AutoFarmState.CurrentTarget = nil
	AutoFarmState.CurrentCachedRecord = nil
	cancelFarmTween()

	FlyState.Enabled = false
	FlyState.YLevel = nil

	restoreAllHitboxes()
	removeAllHitboxVisuals()

	disconnectAll()

	table.clear(BoundContainers)
end, "CrimsonHubMainMovementCleanup")

