EnemyDataTab:Section({
	name = "Enemy & Mimic Positions",
	subtitle = "Records the last-seen pivot before StreamingEnabled unloads them",
	icon = Library.Icons.location,
})

EnemyDataDropdown = EnemyDataTab:SearchDropdown({
	name = "Recorded Enemy",
	description = "Choose a cached enemy or Mimic position",
	searchPlaceholder = "Search recorded enemies...",
	maxVisible = 8,
	multi = false,
	items = {},
	placeholder = "No positions recorded yet",
	flag = "enemyDataSelectedRecord",

	callback = function(value)
		local key =
			EnemyDataLabelToKey[value]

		EnemyPositionState.SelectedKey = key

		if EnemyDataCodeBlock then
			EnemyDataCodeBlock:Set(
				formatEnemyPositionRecord(
					EnemyPositionState.Records[key]
				)
			)
		end
	end,
})

EnemyDataCodeBlock = EnemyDataTab:CodeBlock({
	title = "Selected Position",
	code = "-- No enemy positions recorded yet",
	copy = true,
	maxHeight = 240,
})

EnemyDataTab:Button({
	name = "Scan Visible Enemies Now",
	description = "Updates names and last-seen pivots from every Enemies folder",
	icon = Library.Icons.refresh,

	callback = function()
		scanEnemyNamesAndMimics()
		refreshEnemyDataUI()
	end,
})

EnemyDataTab:Button({
	name = "Copy Selected Position",
	description = "Copies the selected area, enemy name, position, and full pivot",
	icon = Library.Icons.copy,

	callback = function()
		local record =
			EnemyPositionState.Records[
				EnemyPositionState.SelectedKey
			]

		copyText(
			formatEnemyPositionRecord(record)
		)
	end,
})

EnemyDataTab:Button({
	name = "Copy All Enemy Data",
	description = "Copies every recorded Enemy and Mimic position for you to send",
	icon = Library.Icons.copy,

	callback = function()
		copyText(
			formatAllEnemyPositionRecords()
		)
	end,
})

EnemyDataTab:Button({
	name = "Clear Recorded Positions",
	description = "Deletes the saved last-seen position cache",
	icon = Library.Icons.trash,

	callback = function()
		table.clear(EnemyPositionState.Records)
		table.clear(
			EnemyPositionState.InstanceRecordKeys
		)

		PersistentFarmState.PositionRecords =
			EnemyPositionState.Records

		EnemyPositionState.SelectedKey = nil
		EnemyPositionState.TravelIndex = 0
		EnemyPositionState.NewRecordVersion += 1

		refreshEnemyDataUI()
	end,
})

EnemyDataTab:Info({
	text = "The cache keeps area, enemy name, Mimic type, position, "
		.. "and full CFrame after the model streams out. "
		.. "Use Copy All Enemy Data and paste it back into chat.",
})

scanEnemyNamesAndMimics()
refreshEnemyDataUI()

local EnemyDataRefreshConnection =
	RunService.Heartbeat:Connect(function()
		if not EnemyPositionState._NextUIRefresh
			or os.clock()
				>= EnemyPositionState._NextUIRefresh then

			EnemyPositionState._NextUIRefresh =
				os.clock() + 1

			local version =
				EnemyPositionState.NewRecordVersion

			if EnemyPositionState._LastUIVersion
				~= version then

				EnemyPositionState._LastUIVersion =
					version

				refreshEnemyDataUI()
			elseif EnemyDataCodeBlock
				and EnemyPositionState.SelectedKey then

				EnemyDataCodeBlock:Set(
					formatEnemyPositionRecord(
						EnemyPositionState.Records[
							EnemyPositionState.SelectedKey
						]
					)
				)
			end
		end
	end)

trackConnection(EnemyDataRefreshConnection)

