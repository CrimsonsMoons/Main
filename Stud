local function sortedEnemyNames()
	local names = {}

	for name, exists in pairs(AutoFarmState.EnemyNames) do
		if exists
			and not isBlacklistedEnemyName(name)
			and not isMimicName(name) then

			table.insert(names, name)
		end
	end

	table.sort(names, function(a, b)
		return string.lower(a) < string.lower(b)
	end)

