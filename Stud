		if not AutoFarmState._NextMimicScan
			or os.clock()
				>= AutoFarmState._NextMimicScan then

			AutoFarmState._NextMimicScan =
				os.clock() + 1

			scanEnemyNamesAndMimics()
		end
	end)

trackConnection(EnemyNameScannerConnection)

