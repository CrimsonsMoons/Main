local FlyToggle

local function setFlyEnabled(state, synchronizeToggle)
	FlyState.Enabled = state == true
	FlyState.YLevel = nil

	if synchronizeToggle and FlyToggle then
		FlyToggle:Set(FlyState.Enabled, true)
	end

	if not FlyState.Enabled then
		local root = getRoot()

		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	print("Fly:", FlyState.Enabled and "ON" or "OFF")
end

local FlyConnection = RunService.PreSimulation:Connect(function(deltaTime)
	if not FlyState.Enabled or not isAlive() then
		FlyState.YLevel = nil
		return
	end

	local root = getRoot()
	local humanoid = getHumanoid()

	if not root or not humanoid then
		return
	end

	if FlyState.YLevel == nil then
		FlyState.YLevel = root.Position.Y
	end

	local verticalInput = 0

	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		verticalInput += 1
	end

	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		verticalInput -= 1
	end

	FlyState.YLevel +=
		verticalInput
		* FlyState.VerticalSpeed
		* deltaTime

	root.CFrame +=
		humanoid.MoveDirection
		* FlyState.Speed
		* deltaTime

	local velocity = root.AssemblyLinearVelocity

	root.AssemblyLinearVelocity = Vector3.new(
		velocity.X,
		0,
		velocity.Z
	)

	root.CFrame += Vector3.new(
		0,
		FlyState.YLevel - root.Position.Y,
		0
	)
end)

trackConnection(FlyConnection)

