local EnemyDataDropdown
local EnemyDataCodeBlock
local EnemyDataLabelToKey = {}

local function formatNumber(value)
	return string.format("%.6f", tonumber(value) or 0)
end

local function formatCFrame(cframe)
	local components = {
		cframe:GetComponents(),
	}

	for index, value in ipairs(components) do
		components[index] = formatNumber(value)
	end

	return "CFrame.new("
		.. table.concat(components, ", ")
		.. ")"
end

local function formatEnemyPositionRecord(record)
	if not record
		or typeof(record.CFrame) ~= "CFrame" then

		return "-- No enemy position selected"
	end

	local position = record.CFrame.Position

	return table.concat({
		"{",
		'    Area = "' .. tostring(record.Area) .. '",',
		'    Name = "' .. tostring(record.Name) .. '",',
		'    Type = "' .. tostring(record.Kind) .. '",',
		"    Position = Vector3.new("
			.. formatNumber(position.X) .. ", "
			.. formatNumber(position.Y) .. ", "
			.. formatNumber(position.Z) .. "),",
		"    Pivot = " .. formatCFrame(record.CFrame) .. ",",
		"    RecordId = \"" .. tostring(record.Key) .. "\",",
		"}",
	}, "\n")
end

local function formatAllEnemyPositionRecords()
	local lines = {
		"-- Crimson Hub enemy and Mimic position data",
		"-- Paste this entire block back into ChatGPT.",
		"return {",
	}

	for _, key in ipairs(getSortedPositionRecordKeys()) do
		local record =
			EnemyPositionState.Records[key]

		local formatted =
			formatEnemyPositionRecord(record)

		local recordLines = {}

		for line in formatted:gmatch("[^\n]+") do
			table.insert(recordLines, line)
		end

		for index, line in ipairs(recordLines) do
			if index == #recordLines and line == "}" then
				table.insert(lines, "    },")
			else
				table.insert(lines, "    " .. line)
			end
		end

		table.insert(lines, "")
	end

	table.insert(lines, "}")

	return table.concat(lines, "\n")
end

local function copyText(textValue)
	local clipboardFunction

	if type(setclipboard) == "function" then
		clipboardFunction = setclipboard
	elseif type(toclipboard) == "function" then
		clipboardFunction = toclipboard
	elseif type(syn) == "table"
		and type(syn.write_clipboard) == "function" then

		clipboardFunction = syn.write_clipboard
	end

	if clipboardFunction then
		local ok, errorMessage =
			pcall(clipboardFunction, textValue)

		if ok then
			print("Copied enemy position data to clipboard")
			return true
		end

		warn(
			"Clipboard copy failed:",
			errorMessage
		)
	end

	print(textValue)
	warn(
		"Clipboard API unavailable. "
		.. "The enemy data was printed to the console."
	)

	return false
end

local function makeEnemyDataDropdownLabel(record)
	local position = record.CFrame.Position

	return string.format(
		"[%s] %s | %s | %s | %.1f, %.1f, %.1f",
		tostring(record.Key),
		tostring(record.Kind),
		tostring(record.Area),
		tostring(record.Name),
		position.X,
		position.Y,
		position.Z
	)
end

local function refreshEnemyDataUI()
	if not EnemyDataDropdown then
		return
	end

	local items = {}
	local previousKey =
		EnemyPositionState.SelectedKey

	table.clear(EnemyDataLabelToKey)

	for _, key in ipairs(getSortedPositionRecordKeys()) do
		local record =
			EnemyPositionState.Records[key]

		local label =
			makeEnemyDataDropdownLabel(record)

		EnemyDataLabelToKey[label] = key
		table.insert(items, label)
	end

	EnemyDataDropdown:SetItems(items)

	if previousKey
		and EnemyPositionState.Records[previousKey] then

		local selectedLabel

		for label, key in pairs(EnemyDataLabelToKey) do
			if key == previousKey then
				selectedLabel = label
				break
			end
		end

		if selectedLabel then
			EnemyDataDropdown:Set(
				selectedLabel,
				true
			)
		end
	elseif items[1] then
		EnemyPositionState.SelectedKey =
			EnemyDataLabelToKey[items[1]]

		EnemyDataDropdown:Set(
			items[1],
			true
		)
	end

	if EnemyDataCodeBlock then
		EnemyDataCodeBlock:Set(
			formatEnemyPositionRecord(
				EnemyPositionState.Records[
					EnemyPositionState.SelectedKey
				]
			)
		)
	end
end

