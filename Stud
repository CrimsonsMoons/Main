local function getEnemyHumanoid(enemy)
	if not enemy or not enemy.Parent then
		return nil
	end

	local named = enemy:FindFirstChild("EnemyHumanoid", true)

	if named and named:IsA("Humanoid") then
		return named
	end

	return enemy:FindFirstChildWhichIsA("Humanoid", true)
end

local function getEnemyRoot(enemy)
	if not enemy or not enemy.Parent then
		return nil
	end

	if enemy:IsA("BasePart") then
		return enemy
	end

	local primaryPart =
		enemy:IsA("Model")
		and enemy.PrimaryPart
		or nil

	return enemy:FindFirstChild("HumanoidRootPart", true)
		or primaryPart
		or enemy:FindFirstChildWhichIsA("BasePart", true)
end

local function getEnemyPivot(enemy)
	if not enemy or not enemy.Parent then
		return nil
	end

	if enemy:IsA("Model") then
		local ok, pivot = pcall(function()
			return enemy:GetPivot()
		end)

		if ok and typeof(pivot) == "CFrame" then
			return pivot
		end
	end

	local root = getEnemyRoot(enemy)

	return root and root.CFrame or nil
end

local function nextPositionRecordKey()
	PersistentFarmState.NextPositionRecordId += 1

	return string.format(
		"R%05d",
		PersistentFarmState.NextPositionRecordId
	)
end

local function findNearestPositionRecord(
	areaName,
	enemyName,
	position,
	maxDistance
)
	local bestKey
	local bestDistance = math.huge

	for key, record in pairs(EnemyPositionState.Records) do
		if record.Area == areaName
			and record.Name == enemyName
			and typeof(record.CFrame) == "CFrame" then

			local distance =
				(record.CFrame.Position - position).Magnitude

			if distance <= maxDistance
				and distance < bestDistance then

				bestKey = key
				bestDistance = distance
			end
		end
	end

	return bestKey
end

local function recordEnemyPivot(areaName, enemy)
	if not enemy
		or not enemy.Parent
		or isBlacklistedEnemyName(enemy.Name) then

		return false
	end

	local pivot = getEnemyPivot(enemy)

	if not pivot then
		return false
	end

	local key =
		EnemyPositionState.InstanceRecordKeys[enemy]

	if not key then
		key = findNearestPositionRecord(
			areaName,
			enemy.Name,
			pivot.Position,
			12
		)

		if not key then
			key = nextPositionRecordKey()
			EnemyPositionState.NewRecordVersion += 1
		end

		EnemyPositionState.InstanceRecordKeys[enemy] = key
	end

	local isNew =
		EnemyPositionState.Records[key] == nil

	EnemyPositionState.Records[key] = {
		Key = key,
		Area = areaName,
		Name = enemy.Name,
		Kind = isMimicName(enemy.Name)
			and "Mimic"
			or "Enemy",
		CFrame = pivot,
		LastSeenUnix = os.time(),
	}

	PersistentFarmState.PositionRecords =
		EnemyPositionState.Records

	if isNew then
		EnemyPositionState.NewRecordVersion += 1
	end

	return isNew
end

local function isAliveEnemy(enemy)
	local humanoid = getEnemyHumanoid(enemy)
	local root = getEnemyRoot(enemy)

	return humanoid
		and root
		and humanoid.Health > 0
		and humanoid.MaxHealth > 0
end

local function rememberEnemyName(name)
	if type(name) ~= "string"
		or isBlacklistedEnemyName(name) then

		return false
	end

	if isMimicName(name) then
		return false
	end

	if AutoFarmState.EnemyNames[name] then
		return false
	end

	AutoFarmState.EnemyNames[name] = true
	PersistentFarmState.EnemyNames = AutoFarmState.EnemyNames

	return true
end

local function rememberMimicName(name)
	if type(name) ~= "string"
		or isBlacklistedEnemyName(name)
		or not isMimicName(name) then

		return false
	end

	if AutoFarmState.MimicNames[name] then
		return false
	end

	AutoFarmState.MimicNames[name] = true
	PersistentFarmState.MimicNames = AutoFarmState.MimicNames

	return true
end

local function scanEnemyNamesAndMimics()
	local enemyChanged = false
	local mimicChanged = false

	for _, areaName in ipairs(AREA_NAMES) do
		local folder = getAreaEnemiesFolder(areaName)

		if folder then
			for _, enemy in ipairs(folder:GetChildren()) do
				if not isBlacklistedEnemyName(enemy.Name) then
					recordEnemyPivot(areaName, enemy)

					if isMimicName(enemy.Name) then
						if rememberMimicName(enemy.Name) then
							mimicChanged = true
						end
					else
						if rememberEnemyName(enemy.Name) then
							enemyChanged = true
						end
					end
				end
			end
		end
	end

	-- These caches only grow. Names are never removed when enemies
	-- despawn, so selections remain available for future respawns.
	if enemyChanged and EnemyDropdown then
		EnemyDropdown:SetItems(sortedEnemyNames())
		EnemyDropdown:Set(
			AutoFarmState.SelectedEnemies,
			true
		)
	end

	if mimicChanged and MimicDropdown then
		MimicDropdown:SetItems(sortedMimicNames())
		MimicDropdown:Set(
			AutoFarmState.SelectedMimics,
			true
		)
	end
end

local function targetMatchesNameFilters(enemy, enemySet, mimicSet)
	if isBlacklistedEnemyName(enemy.Name) then
		return false
	end

	if isMimicName(enemy.Name) then
		return next(mimicSet) == nil
			or mimicSet[enemy.Name] == true
	end

	return next(enemySet) == nil
		or enemySet[enemy.Name] == true
end

local function collectFarmTargets()
	local targets = {}
	local selectedEnemySet =
		arrayToSet(AutoFarmState.SelectedEnemies)
	local selectedMimicSet =
		arrayToSet(AutoFarmState.SelectedMimics)

	for _, areaName in ipairs(AREA_NAMES) do
		local folder = getAreaEnemiesFolder(areaName)

		if folder then
			for _, enemy in ipairs(
				folder:GetChildren()
			) do
				if not isBlacklistedEnemyName(enemy.Name) then
					recordEnemyPivot(areaName, enemy)

					local mimic = isMimicName(enemy.Name)

					if mimic then
						rememberMimicName(enemy.Name)
					else
						rememberEnemyName(enemy.Name)
					end

					local categoryEnabled =
						(mimic and AutoFarmState.MimicEnabled)
						or (
							not mimic
							and AutoFarmState.EnemyEnabled
						)

					if categoryEnabled
						and isAliveEnemy(enemy)
						and targetMatchesNameFilters(
							enemy,
							selectedEnemySet,
							selectedMimicSet
						) then

						table.insert(targets, enemy)
					end
				end
			end
		end
	end

	return targets
end

local function isAnyFarmEnabled()
	return AutoFarmState.EnemyEnabled
		or AutoFarmState.MimicEnabled
end

local function getSortedPositionRecordKeys()
	local keys = {}

	for key, record in pairs(EnemyPositionState.Records) do
		if type(record) == "table"
			and typeof(record.CFrame) == "CFrame"
			and not isBlacklistedEnemyName(record.Name) then

			table.insert(keys, key)
		end
	end

	table.sort(keys, function(a, b)
		local recordA = EnemyPositionState.Records[a]
		local recordB = EnemyPositionState.Records[b]

		local areaA = tostring(recordA and recordA.Area or "")
		local areaB = tostring(recordB and recordB.Area or "")

		if areaA ~= areaB then
			return areaA < areaB
		end

		local nameA = tostring(recordA and recordA.Name or "")
		local nameB = tostring(recordB and recordB.Name or "")

		if nameA ~= nameB then
			return nameA < nameB
		end

		return a < b
	end)

	return keys
end

local function cachedRecordMatchesFilters(
	record,
	enemySet,
	mimicSet
)
	if not record
		or not record.Name
		or not record.Area
		or typeof(record.CFrame) ~= "CFrame"
		or isBlacklistedEnemyName(record.Name) then

		return false
	end

	local mimic = record.Kind == "Mimic"
		or isMimicName(record.Name)

	if mimic then
		if not AutoFarmState.MimicEnabled then
			return false
		end

		return next(mimicSet) == nil
			or mimicSet[record.Name] == true
	end

	if not AutoFarmState.EnemyEnabled then
		return false
	end

	return next(enemySet) == nil
		or enemySet[record.Name] == true
end

local function getNextCachedFarmRecord()
	local keys = getSortedPositionRecordKeys()

	if #keys == 0 then
		return nil
	end

	local enemySet =
		arrayToSet(AutoFarmState.SelectedEnemies)
	local mimicSet =
		arrayToSet(AutoFarmState.SelectedMimics)

	for offset = 1, #keys do
		local index =
			((EnemyPositionState.TravelIndex + offset - 1)
				% #keys) + 1

		local key = keys[index]
		local record =
			EnemyPositionState.Records[key]

		if cachedRecordMatchesFilters(
			record,
			enemySet,
			mimicSet
		) then
			EnemyPositionState.TravelIndex = index
			return record
		end
	end

	return nil
end

local function cancelFarmTween()
	local tween = AutoFarmState.CurrentTween

	if tween then
		pcall(function()
			tween:Cancel()
		end)
	end

	AutoFarmState.CurrentTween = nil
end

local function getFarmCharacterRoot()
	local character = getMovementCharacter()

	return character
		and character:FindFirstChild("HumanoidRootPart")
end

local function tweenToCachedRecord(record)
	local playerRoot = getFarmCharacterRoot()

	if not playerRoot
		or not record
		or typeof(record.CFrame) ~= "CFrame" then

		return false
	end

	local destination =
		record.CFrame * CFrame.new(0, 3, 0)

	local distance =
		(playerRoot.Position - destination.Position).Magnitude

	local duration = math.clamp(
		distance / AutoFarmState.TweenSpeed,
		0.05,
		2
	)

	cancelFarmTween()

	local tween = TweenService:Create(
		playerRoot,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = destination,
		}
	)

	AutoFarmState.CurrentTween = tween
	AutoFarmState.CurrentCachedRecord = record

	tween:Play()
	tween.Completed:Wait()

	AutoFarmState.CurrentTween = nil

	return true
end

local function tweenBehindEnemy(enemy)
	local playerRoot = getFarmCharacterRoot()
	local enemyRoot = getEnemyRoot(enemy)
	local enemyHumanoid = getEnemyHumanoid(enemy)

	if not playerRoot
		or not enemyRoot
		or not enemyHumanoid
		or enemyHumanoid.Health <= 0 then

		return false
	end

	local destination =
		enemyRoot.CFrame
		* CFrame.new(
			0,
			0,
			AutoFarmState.BehindDistance
		)

	local distance =
		(playerRoot.Position - destination.Position).Magnitude

	local duration = math.clamp(
		distance / AutoFarmState.TweenSpeed,
		0.03,
		0.25
	)

	cancelFarmTween()

	local tween = TweenService:Create(
		playerRoot,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = destination,
		}
	)

	AutoFarmState.CurrentTween = tween
	tween:Play()

	task.wait(math.min(duration, 0.10))

	return enemyHumanoid.Health > 0
		and enemy.Parent ~= nil
end

local function runAutoFarm(generation)
	while isAnyFarmEnabled()
		and AutoFarmState.Generation == generation do

		scanEnemyNamesAndMimics()

		local targets = collectFarmTargets()
		local target = targets[1]

		if not target then
			AutoFarmState.CurrentTarget = nil
			cancelFarmTween()

			local cachedRecord =
				getNextCachedFarmRecord()

			if cachedRecord then
				tweenToCachedRecord(cachedRecord)
				task.wait(0.15)
			else
				task.wait(0.20)
			end

			continue
		end

		AutoFarmState.CurrentTarget = target

		while isAnyFarmEnabled()
			and AutoFarmState.Generation == generation
			and target.Parent
			and isAliveEnemy(target) do

			local targetIsMimic =
				isMimicName(target.Name)

			local categoryStillEnabled =
				(
					targetIsMimic
					and AutoFarmState.MimicEnabled
				)
				or (
					not targetIsMimic
					and AutoFarmState.EnemyEnabled
				)

			if not categoryStillEnabled
				or not tweenBehindEnemy(target) then

				break
			end
		end

		cancelFarmTween()
		AutoFarmState.CurrentTarget = nil
		task.wait()
	end

	cancelFarmTween()
	AutoFarmState.CurrentTarget = nil
	AutoFarmState.CurrentCachedRecord = nil
end

local function restartAutoFarmLoop()
	AutoFarmState.Generation += 1
	cancelFarmTween()
	AutoFarmState.CurrentTarget = nil
	AutoFarmState.CurrentCachedRecord = nil

	if not isAnyFarmEnabled() then
		return
	end

	local generation = AutoFarmState.Generation

	task.spawn(function()
		runAutoFarm(generation)
	end)
end

local function setEnemyFarmEnabled(state, synchronizeToggle)
	AutoFarmState.EnemyEnabled = state == true

	if synchronizeToggle and EnemyFarmToggle then
		EnemyFarmToggle:Set(
			AutoFarmState.EnemyEnabled,
			true
		)
	end

	restartAutoFarmLoop()

	print(
		"Auto Farm Enemies:",
		AutoFarmState.EnemyEnabled and "ON" or "OFF"
	)
end

local function setMimicFarmEnabled(state, synchronizeToggle)
	AutoFarmState.MimicEnabled = state == true

	if synchronizeToggle and MimicFarmToggle then
		MimicFarmToggle:Set(
			AutoFarmState.MimicEnabled,
			true
		)
	end

	restartAutoFarmLoop()

	print(
		"Auto Farm Mimics:",
		AutoFarmState.MimicEnabled and "ON" or "OFF"
	)
end

-- Discover enemy and Mimic names even while Auto Farm is off.
-- The name caches are never cleared when folders become empty.
local EnemyNameScannerConnection =
